enum LineItemKind {
  SERVICE
  LABOR
  MATERIAL
  EQUIPMENT
  DISCOUNT
  OTHER
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuoteStatus {
  DRAFT
  READY
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  ACH
  EXTERNAL
  MANUAL
  FINANCING
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  VOIDED
}

enum NoteType {
  GENERAL
  TECHNICIAN
  BILLING
  CUSTOMER_SERVICE
  SALES
  INTERNAL
  WARNING
  ACCESS
}

enum EntityType {
  CUSTOMER
  LOCATION
  EQUIPMENT
  LEAD
  JOB
  APPOINTMENT
  QUOTE
  INVOICE
  PAYMENT
  AGREEMENT
  EMPLOYEE
  EXPENSE
  TASK
  TENANT
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  MANUAL
  WARRANTY
  CONTRACT
  RECEIPT
  BEFORE_PHOTO
  AFTER_PHOTO
  PROFILE_PHOTO
  LOGO
  SIGNATURE
  OTHER
}

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
}

enum PublicLinkKind {
  QUOTE
  INVOICE
  PORTAL
}

enum AgreementStatus {
  PENDING_RENEWAL
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  ONE_TIME
}

enum VisitStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  QUOTE_APPROVED
