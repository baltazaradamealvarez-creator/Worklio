// Worklio — multi-tenant field-service platform schema.
//
// Tenancy rules (enforced in three layers, see docs/ARCHITECTURE.md):
//   1. Every tenant-owned table carries `tenantId` and a UNIQUE(tenantId, id) so that
//      references to it can be composite foreign keys `(tenantId, fooId)`. A row in
//      tenant A can therefore never point at a row in tenant B, at the database level.
//   2. Postgres row-level security policies (see migrations) filter by
//      `current_setting('app.tenant_id')`, set per query by the tenant-scoped client.
//   3. The application's tenant-scoped Prisma client injects `tenantId` into every
//      query and refuses to run without a tenant.
//
// Money is stored as integer minor units (cents). Rates are stored in basis points.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  INVITED
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AuthTokenType {
  PASSWORD_RESET
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  DO_NOT_SERVICE
}

enum ContactMethod {
  PHONE
  SMS
  EMAIL
}

enum EquipmentType {
  FURNACE
  AIR_CONDITIONER
  HEAT_PUMP
  AIR_HANDLER
  MINI_SPLIT
  ROOFTOP_UNIT
  BOILER
  THERMOSTAT
  HUMIDIFIER
  DEHUMIDIFIER
  VENTILATION
  COMMERCIAL
  OTHER
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NEEDS_REPLACEMENT
  DECOMMISSIONED
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SCHEDULED
  ESTIMATE_NEEDED
  QUOTE_SENT
  WON
  LOST
}

enum JobStatus {
  NEW
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  EN_ROUTE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  NEEDS_FOLLOW_UP
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  DISPATCHED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
