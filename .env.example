# --- Database -------------------------------------------------------------
# Runtime connection: a NON-superuser role without BYPASSRLS so Postgres
# row-level security is enforced for the application.
DATABASE_URL="postgresql://worklio_app:worklio_app@localhost:5432/worklio"
# Migration/owner connection (used by prisma migrate + seed only).
DIRECT_URL="postgresql://worklio_owner:worklio_owner@localhost:5432/worklio"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
# 32+ random bytes, used to sign short-lived tokens. `openssl rand -base64 32`
APP_SECRET="change-me-in-production-please-use-32-random-bytes"

# --- Email (provider abstraction: console | resend | smtp) -----------------
EMAIL_PROVIDER="console"
EMAIL_FROM="Worklio <no-reply@example.com>"
# RESEND_API_KEY=""            # required when EMAIL_PROVIDER=resend

# --- File storage (local | s3) ----------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""  S3_REGION=""  S3_ACCESS_KEY_ID=""  S3_SECRET_ACCESS_KEY=""  S3_ENDPOINT=""

# --- Payments (manual | stripe) ---------------------------------------------
PAYMENT_PROVIDER="manual"
# STRIPE_SECRET_KEY=""  STRIPE_WEBHOOK_SECRET=""
